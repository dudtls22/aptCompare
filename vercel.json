{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "lib/**,data/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-notify",
      "schedule": "30 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, OPTIONS" },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Client-Id"
        }
      ]
    }
  ]
}
